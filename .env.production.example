# 启信通后端 - 生产环境配置示例
# 复制此文件为 .env，填入真实值

# 服务端口（不修改）
PORT=3000
NODE_ENV=production

# JWT 密钥（生产环境必须修改为随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# 微信支付（沙箱/生产）
WECHAT_PAY_MCHID=your-merchant-id
WECHAT_PAY_API_KEY=your-api-key
WECHAT_PAY_APPID=wx1234567890abcdef
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/v1/pay/callback

# 数据库（MySQL 连接信息，生产环境从腾讯云托管页面获取）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=qxt_prod
DB_USER=qxt_user
DB_PASSWORD=your-db-password

# Redis（可选，用于会话管理）
REDIS_HOST=localhost
REDIS_PORT=6379

# 前端地址（用于 CORS）
FRONTEND_ORIGIN=https://your-domain.com
